# 服务端口
PORT=3000

# MySQL 连接
DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_password_here

# 阿里云 OSS 图片存储
