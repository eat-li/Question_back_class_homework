# 服务端口
PORT=3000

# 管理员登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你自己的密码
AUTH_SECRET=请改成一段随机字符串

# 运行环境：development / production
NODE_ENV=development

# CORS 白名单（逗号分隔）；生产环境默认仅允许 http://localhost:5173
# 例：CORS_ORIGINS=http://localhost:5173,https://teacher.example.com
CORS_ORIGINS=*

# 请求限流（生产环境默认开启；本地可用 RATE_LIMIT_ENABLED=true 手动测试）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# MySQL 连接
DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_password_here

# 阿里云 OSS 图片存储
OSS_REGION=oss-cn-chengdu
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket
OSS_BASE_URL=https://your-bucket.oss-cn-chengdu.aliyuncs.com

# AI 排版（可选；配置后前端无需再填 API Key）
# 默认使用 DeepSeek OpenAI 兼容接口
AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 小程序 / 家长端只读访客
# GUEST_CODE：配置了则 POST /api/auth/guest 必须传正确访问码；留空表示对只读接口开放
# 访客令牌只能访问 /api/open/*，且该路由组在中间件层强制只允许 GET/HEAD，无法写入任何数据
GUEST_CODE=
# 访客令牌有效期（毫秒），默认 7 天
GUEST_TOKEN_TTL_MS=604800000
