# 服务端口
PORT=3000

# 管理员登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你自己的密码
AUTH_SECRET=请改成一段随机字符串

# 运行环境：development / production
NODE_ENV=development

# CORS 白名单（逗号分隔）；生产环境默认仅允许 http://localhost:5173
# 例：CORS_ORIGINS=http://localhost:5173,https://teacher.example.com
CORS_ORIGINS=*

# 未传分页参数的列表接口最多返回多少条，避免误拉全表
DEFAULT_LIST_LIMIT=1000

# 进程内缓存最大条目数
CACHE_MAX_ENTRIES=200

# —— 启动优化（数据库在远程主机时，每条 SQL 都要一次网络往返）——
# 建表策略：auto(默认)=先用一次 SHOW TABLES 比对，缺表才 sync；true=每次 sync；false=跳过
# （sequelize.sync() 逐表检查，远程库上约 1.2s；auto 命中时仅约 40ms）
DB_SYNC=auto
# 是否在启动时补建索引。默认关闭：索引由迁移 001 统一管理；
# 开着会在每次启动重复发 20+ 条必然失败的 CREATE INDEX（含重试，实测可占 5s 以上）
DB_ENSURE_INDEXES=false

# 数据库连接池（按需调整）。min>0 可保留常驻连接，避免空闲 10s 后每次请求
# 重新握手（远程库单次建连约 0.5-0.7s），代价是启动稍慢一点
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_RETRY_MAX=2

# 请求限流（生产环境默认开启；本地可用 RATE_LIMIT_ENABLED=true 手动测试）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# MySQL 连接
DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_password_here
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_RETRY_MAX=2

# 阿里云 OSS 图片存储
OSS_REGION=oss-cn-chengdu
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket
OSS_BASE_URL=https://your-bucket.oss-cn-chengdu.aliyuncs.com

# AI 排版（可选；配置后前端无需再填 API Key）
# 默认使用 DeepSeek OpenAI 兼容接口
AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 允许前端选择的 AI OpenAI 兼容接口地址，逗号分隔；内置允许 DeepSeek 与 OpenAI 官方地址
AI_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.openai.com/v1
# 放行任意接口地址（自建 / 第三方中转 / 本地模型用）。
# 默认 false：仅允许上面的白名单，避免服务端被诱导请求任意地址（SSRF）。
# 设为 true 时不校验地址（允许 http，便于连本地 Ollama / LM Studio）；仅影响 AI 排版接口。
AI_ALLOW_ANY_BASE_URL=false

# 结论生成走流式（SSE）后不再限制总时长，只限制「多久没有任何数据返回」：
# 模型边生成边回传，只要不断流就不会被判超时；彻底卡住超过该值才中断（毫秒）
AI_STREAM_IDLE_MS=60000
# 单次流式生成的硬上限，防止异常连接永不结束（毫秒，默认 10 分钟）
AI_STREAM_MAX_MS=600000

# 小程序 / 家长端只读访客
# GUEST_CODE：配置了则 POST /api/auth/guest 必须传正确访问码；留空表示对只读接口开放
# 访客令牌只能访问 /api/open/*，且该路由组在中间件层强制只允许 GET/HEAD，无法写入任何数据
GUEST_CODE=
# 访客令牌有效期（毫秒），默认 7 天
GUEST_TOKEN_TTL_MS=604800000
